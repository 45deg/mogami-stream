  "methodology": {
    "isolation": "One fresh process per scenario/library; jobs run sequentially in seeded shuffled order; one default warmup, three default measured samples with the same seed; optional GC between iterations; imports, oracle arrays and GC outside timing",
    "timing": "Includes pipeline construction, timer waits, output validation, instrumentation, and cleanup; excludes process startup; cancellation next() settlement and iterator.closed measured separately from actual abort time",
    "memory": "process.memoryUsage() sampled every sampleMs and once after cleanup; independent peak for each field, not a simultaneous snapshot or guaranteed upper bound; event-loop delays can miss peaks; process RSS/heap includes runtime, library and instrumentation; preallocated oracle arrays scale with input count and are included in baseline; no memory ceiling or leak proof",
    "bounds": "maxActive counts active attempts; retries retain stage slots between attempts; maxAhead = yielded inputs minus sink receipts; maxReady = successful attempts minus sink receipts; logical bounds asserted per transition, not heap limits; includes at most one item handed to sink",
    "comparison": "Ordered delayed/slow-sink/retry only, same lazy async numeric source, payload, timer function, concurrency, capacity/backpressure, validation and sink; retry is one retry after 2 ms, failing every fifth ID only on attempt 1; p-map uses a matching callback wrapper; cancellation and unordered/rate have no library ranking",
    "rate": "rateLimit counts source next() including final done; timestamp oracle observes inside source after admission, permits 1 ms observation skew at sliding-window boundaries; no per-attempt rate limiting claimed",
    "statistics": "Every sample plus median/min/max; host-specific synthetic timers, not network/storage I/O; no confidence interval or causal queue comparison"
  },
