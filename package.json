{
  "name": "mogami-stream",
  "version": "0.1.0",
  "description": "Bounded, cancellable AsyncIterable pipelines with zero runtime dependencies.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p test/types/tsconfig.json && tsc -p test/types/tsconfig.worker.json && tsc -p test/types/tsconfig.node.json",
    "test": "pnpm build && node --test --test-timeout=10000 test/*.test.mjs",
    "test:bun": "pnpm build && bun test test/*.test.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check": "pnpm test && pnpm test:dist && pnpm typecheck && pnpm check:dist && pnpm format:check",
    "test:browser": "pnpm build && node scripts/test-browser.mjs",
    "test:runtime-watchdog": "pnpm build && node --test --test-timeout=30000 test/runtime/watchdog.test.mjs",
    "test:cloudflare": "pnpm build && node scripts/test-cloudflare.mjs",
    "test:package": "pnpm build && node scripts/test-package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "pnpm build && pnpm check:dist",
    "bench": "pnpm build && node benchmarks/run.mjs",
    "docs": "pnpm docs:build",
    "docs:api": "typedoc",
    "docs:prepare": "pnpm build && pnpm docs:api && node scripts/prepare-docs.mjs",
    "docs:dev": "pnpm docs:prepare && vitepress dev docs --host 127.0.0.1",
    "docs:build": "pnpm docs:typecheck && pnpm docs:prepare && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:typecheck": "tsc -p docs/examples/tsconfig.json",
    "docs:test": "pnpm docs:build && node scripts/test-docs.mjs",
    "bench:svg": "pnpm build && node benchmarks/render-svg.mjs",
    "test:dist": "node scripts/test-dist.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "miniflare": "^4.20260730.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3",
    "vitepress": "^1.6.4",
    "vue": "^3.5.44"
  },
  "packageManager": "pnpm@11.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/45deg/mogami-stream.git"
  },
  "homepage": "https://45deg.github.io/mogami-stream/",
  "bugs": {
    "url": "https://github.com/45deg/mogami-stream/issues"
  }
}
